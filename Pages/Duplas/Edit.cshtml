@page "{id:int}"
@model SandStats.Pages.Duplas.EditModel

<div class="container my-4">
    <h2 class="fw-bold text-primary mb-3">Editar Dupla</h2>

    <form method="post">
        <input type="hidden" asp-for="Dupla.Id" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Jugador Posición 4</label>
            <select asp-for="Dupla.Jugador1Id" class="form-select" asp-items="Model.JugadoresRol4">
                <option value="">-- Seleccionar jugador Rol 4 --</option>
            </select>
            <span asp-validation-for="Dupla.Jugador1Id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Jugador Posición 2</label>
            <select asp-for="Dupla.Jugador2Id" class="form-select" asp-items="Model.JugadoresRol2">
                <option value="">-- Seleccionar jugador Rol 2 --</option>
            </select>
            <span asp-validation-for="Dupla.Jugador2Id" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary text-uppercase px-4">Guardar cambios</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const form = document.querySelector('form');
        const jugador1 = document.getElementById('Dupla_Jugador1Id');
        const jugador2 = document.getElementById('Dupla_Jugador2Id');

        form.addEventListener('submit', function (e) {
            if (jugador1.value === jugador2.value) {
                e.preventDefault();
                let errorSpan = document.querySelector('[data-valmsg-for="Dupla.Jugador2Id"]');
                if (errorSpan) {
                    errorSpan.textContent = "No se puede seleccionar el mismo jugador dos veces.";
                }
            }
        });

        jugador1.addEventListener('change', clearError);
        jugador2.addEventListener('change', clearError);

        function clearError() {
            const errorSpan = document.querySelector('[data-valmsg-for="Dupla.Jugador2Id"]');
            if (errorSpan) errorSpan.textContent = "";
        }
    </script>
}
