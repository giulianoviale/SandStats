@model SandStats.Pages.Estadisticas.K2Report

@functions {
    string Pct(decimal d) => (d * 100m).ToString("0") + "%";
}

@{
    // --- Suma de bloqueos (A1 + A6 + A5) en una sola fila ---
    var bloq = new SandStats.Pages.Estadisticas.K2Counts
    {
        DP = (Model.BloqueoA1?.DP ?? 0) + (Model.BloqueoA6?.DP ?? 0) + (Model.BloqueoA5?.DP ?? 0),
        P = (Model.BloqueoA1?.P ?? 0) + (Model.BloqueoA6?.P ?? 0) + (Model.BloqueoA5?.P ?? 0),
        N = (Model.BloqueoA1?.N ?? 0) + (Model.BloqueoA6?.N ?? 0) + (Model.BloqueoA5?.N ?? 0),
        DN = (Model.BloqueoA1?.DN ?? 0) + (Model.BloqueoA6?.DN ?? 0) + (Model.BloqueoA5?.DN ?? 0),
    };

    // Filas a mostrar (las demás quedan igual)
    var filas = new[]
    {
        new { Nombre = "Puntos jugados en K2", C = Model.PuntosJugados },
        new { Nombre = "Saques FLOTADOS",      C = Model.SaquesFlotado },
        new { Nombre = "Saques POTENCIA",      C = Model.SaquesPotencia },
        new { Nombre = "Bloqueos",             C = bloq } // 👈 fila única sumada
    };

    // Totales (sobre las filas efectivamente mostradas)
    int totalAll = filas.Sum(r => r.C.Total);
    int sumDP = filas.Sum(r => r.C.DP);
    int sumP = filas.Sum(r => r.C.P);
    int sumN = filas.Sum(r => r.C.N);
    int sumDN = filas.Sum(r => r.C.DN);
    decimal efectTotal = totalAll == 0 ? 0m : (sumDP + sumP) / (decimal)totalAll;
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div class="fw-semibold">Efectividad K2</div>
        <div class="badge rounded-pill text-bg-warning fs-6">@Pct(Model.EfectHeadline)</div>
    </div>

    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle text-center mb-2">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Acción</th>
                        <th>%T <span class="text-muted small">(K2)</span></th>
                        <th>Efect</th>
                        <th>%#</th>
                        <th>%+</th>
                        <th>%-</th>
                        <th>%=</th>
                        <th>TOTAL</th>
                        <th>#</th>
                        <th>+</th>
                        <th>-</th>
                        <th>=</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in filas)
                    {
                        var c = r.C;
                        var pctT = totalAll == 0 ? 0m : (decimal)c.Total / totalAll;

                        <tr>
                            <td class="text-start fw-semibold">@r.Nombre</td>
                            <td>@Pct(pctT)</td>
                            <td class="text-end fw-semibold">@Pct(c.Efect)</td>

                            <td>@Pct(c.PctDP)</td>
                            <td>@Pct(c.PctP)</td>
                            <td>@Pct(c.PctN)</td>
                            <td>@Pct(c.PctDN)</td>

                            <td class="text-end fw-semibold">@c.Total</td>

                            <td class="text-end">@c.DP</td>
                            <td class="text-end">@c.P</td>
                            <td class="text-end">@c.N</td>
                            <td class="text-end">@c.DN</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row mt-2 g-3 small">
            <div class="col-auto">Sets JUGADOS: <strong>@Model.SetsJugados</strong></div>
            <div class="col-auto">Errores varios: <strong>@Model.ErroresVarios</strong></div>
            <div class="col-auto">Agregados: <strong>@Model.Agregados</strong></div>
        </div>
    </div>
</div>
