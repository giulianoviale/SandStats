@model SandStats.Pages.Estadisticas.PctResumenVM
@using System.Globalization
@using System.Text

@functions {
    // Normaliza: quita acentos y pasa a minúsculas
    string Normalize(string s)
    {
        s ??= "";
        var nf = s.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(nf.Length);
        foreach (var ch in nf)
            if (CharUnicodeInfo.GetUnicodeCategory(ch) != UnicodeCategory.NonSpacingMark)
                sb.Append(char.ToLowerInvariant(ch));
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    string ColorFor(string label)
    {
        var n = Normalize(label);
        if (n.Contains("ataque diagonal") || n.Contains("atq diago")) return "#e6f7ec"; // verde muy claro
        if (n.Contains("ataque linea") || n.Contains("atq linea")) return "#fff3bf"; // amarillo suave
        if (n.Contains("toque diagonal")) return "#e8f0ff"; // celeste muy claro
        if (n.Contains("toque linea")) return "#EEE5D0"; // marron claro
        if (n.Contains("2da") || n.Contains("2ª")) return "#efe6ff"; // lila muy suave
        return "#ffffff";
    }

    string Pct(double v) => v.ToString("0") + "%";
}

<div class="card">
    <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="fw-semibold">Distribución de acciones</div>
            <!-- Solo AL+AD+TL+TD (sin 2da) -->
            <div class="text-muted small">Total: @Model.TotalAcciones</div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Acción</th>
                        <th class="text-end">% del total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in Model.Items)
                    {
                        var bg = ColorFor(it.Label);
                        <tr>
                            <td style="background-color:@bg">@it.Label</td>
                            <td class="text-end text-danger fw-semibold" style="background-color:@bg">
                                @Pct(Math.Round(it.Pct))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
