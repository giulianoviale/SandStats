@model SandStats.Pages.Estadisticas.AtaquePlayerReport
@using SandStats.Models
@using System.Linq

@functions {
    // === Helpers básicos ===
    string Pct(decimal d) => (d * 100m).ToString("0") + "%";
    string PctInt(decimal d) => Math.Round(d * 100m).ToString("0") + "%";
    string Semaforo(decimal e) =>
        e >= 0.70m ? "bg-success bg-opacity-25"
      : e >= 0.40m ? "bg-warning bg-opacity-25"
      : "bg-danger  bg-opacity-25";

    int PorDe(TipoLado lado, int rol)
    {
        if (lado == TipoLado.Medio) return 3;
        if (rol == 4) return lado == TipoLado.Bueno ? 4 : 2;
        return lado == TipoLado.Bueno ? 2 : 4;
    }
}

@functions {
    // ======================================
    // 🔹 NUEVO: Definición completa de zonas
    // ======================================

    // ==== Zonas por rol ====
    // 🔹 Rol 4 (lado izquierdo)
    static readonly int[] Zonas_AL_R4_Bueno = { 1, 9, 2 };
    static readonly int[] Zonas_AD_R4_Bueno = { 4, 7, 5, 3, 8, 6 };
    static readonly int[] Zonas_AL_R4_Medio = { 1, 9, 2 };
    static readonly int[] Zonas_AD_R4_Medio = { 4, 7, 5, 3, 8, 6 };
    static readonly int[] Zonas_AL_R4_Atras = { 4, 7, 5 };
    static readonly int[] Zonas_AD_R4_Atras = { 1, 9, 2, 3, 8, 6 };

    // 🔹 Rol 2 (lado derecho)
    static readonly int[] Zonas_AL_R2_Bueno = { 4, 7, 5 };
    static readonly int[] Zonas_AD_R2_Bueno = { 1, 9, 2, 3, 8, 6 };
    static readonly int[] Zonas_AL_R2_Medio = { 4, 7, 5 };
    static readonly int[] Zonas_AD_R2_Medio = { 1, 9, 2, 3, 8, 6 };
    static readonly int[] Zonas_AL_R2_Atras = { 1, 9, 2 };
    static readonly int[] Zonas_AD_R2_Atras = { 4, 7, 5, 3, 8, 6 };

    // 🔹 Toques (no se modifican)
    static readonly int[] Zonas_TL_por4 = { 1, 9, 2 };
    static readonly int[] Zonas_TL_por2 = { 5, 7, 4 };
    static readonly int[] Zonas_TD_por4 = { 5, 6, 7, 8, 4, 3 };
    static readonly int[] Zonas_TD_por2 = { 1, 6, 8, 9, 2, 3 };
    static readonly int[] Zonas_2DA = { 1, 6, 5 };

    // ======================================
    // ======================================
    // 🔹 TOQUES (TL / TD) — zonas por rol y lado
    // ======================================

    // Rol 4 (lado izquierdo)
    static readonly int[] Zonas_TL_R4_Bueno = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TL_R4_Medio = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TL_R4_Atras = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };

    static readonly int[] Zonas_TD_R4_Bueno = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TD_R4_Medio = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TD_R4_Atras = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };

    // Rol 2 (lado derecho)
    static readonly int[] Zonas_TL_R2_Bueno = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TL_R2_Medio = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TL_R2_Atras = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };

    static readonly int[] Zonas_TD_R2_Bueno = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TD_R2_Medio = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
    static readonly int[] Zonas_TD_R2_Atras = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };


    // ======================================
    // 🔹 NUEVO: Funciones utilitarias
    // ======================================
    bool EsPrefijo(string nombre, string prefijo)
        => nombre?.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) == true;

    int? ZonaFromNombre(string nombre)
    {
        nombre ??= "";
        if (nombre.StartsWith("Atq2daA", StringComparison.OrdinalIgnoreCase))
        {
            var suf = nombre.Substring("Atq2daA".Length);
            if (int.TryParse(suf, out var z2)) return z2;
            return null;
        }
        for (int i = nombre.Length - 1; i >= 0; i--)
            if (char.IsDigit(nombre[i]) && int.TryParse(nombre[i].ToString(), out var z)) return z;
        return null;
    }

    (int col, int row) CellOfZona(int z) => z switch
    {
        1 => (0, 0),
        6 => (1, 0),
        5 => (2, 0),
        9 => (0, 1),
        8 => (1, 1),
        7 => (2, 1),
        2 => (0, 2),
        3 => (1, 2),
        4 => (2, 2),
        _ => (0, 0)
    };

    // ======================================
    // ✅ CORREGIDO: Validación por rol/lado
    // ======================================
    // ======================================
    // ✅ FUNCIÓN FINAL: ZonaValida
    // ======================================
    bool ZonaValida(string bucket, int rol, TipoLado lado, int zona)
    {
        // ==========================
        // 🔹 Toques (TL / TD)
        // ==========================
        if (bucket == "TL")
        {
            return (rol, lado) switch
            {
                (4, TipoLado.Bueno) => Zonas_TL_R4_Bueno.Contains(zona),
                (4, TipoLado.Medio) => Zonas_TL_R4_Medio.Contains(zona),
                (4, TipoLado.Atras) => Zonas_TL_R4_Atras.Contains(zona),
                (2, TipoLado.Bueno) => Zonas_TL_R2_Bueno.Contains(zona),
                (2, TipoLado.Medio) => Zonas_TL_R2_Medio.Contains(zona),
                (2, TipoLado.Atras) => Zonas_TL_R2_Atras.Contains(zona),
                _ => false
            };
        }

        if (bucket == "TD")
        {
            return (rol, lado) switch
            {
                (4, TipoLado.Bueno) => Zonas_TD_R4_Bueno.Contains(zona),
                (4, TipoLado.Medio) => Zonas_TD_R4_Medio.Contains(zona),
                (4, TipoLado.Atras) => Zonas_TD_R4_Atras.Contains(zona),
                (2, TipoLado.Bueno) => Zonas_TD_R2_Bueno.Contains(zona),
                (2, TipoLado.Medio) => Zonas_TD_R2_Medio.Contains(zona),
                (2, TipoLado.Atras) => Zonas_TD_R2_Atras.Contains(zona),
                _ => false
            };
        }

        // ==========================
        // 🔹 Ataques (AL / AD)
        // ==========================
        if (bucket == "AL")
        {
            return (rol, lado) switch
            {
                (4, TipoLado.Bueno) => Zonas_AL_R4_Bueno.Contains(zona),
                (4, TipoLado.Medio) => Zonas_AL_R4_Medio.Contains(zona),
                (4, TipoLado.Atras) => Zonas_AL_R4_Atras.Contains(zona),
                (2, TipoLado.Bueno) => Zonas_AL_R2_Bueno.Contains(zona),
                (2, TipoLado.Medio) => Zonas_AL_R2_Medio.Contains(zona),
                (2, TipoLado.Atras) => Zonas_AL_R2_Atras.Contains(zona),
                _ => false
            };
        }

        if (bucket == "AD")
        {
            return (rol, lado) switch
            {
                (4, TipoLado.Bueno) => Zonas_AD_R4_Bueno.Contains(zona),
                (4, TipoLado.Medio) => Zonas_AD_R4_Medio.Contains(zona),
                (4, TipoLado.Atras) => Zonas_AD_R4_Atras.Contains(zona),
                (2, TipoLado.Bueno) => Zonas_AD_R2_Bueno.Contains(zona),
                (2, TipoLado.Medio) => Zonas_AD_R2_Medio.Contains(zona),
                (2, TipoLado.Atras) => Zonas_AD_R2_Atras.Contains(zona),
                _ => false
            };
        }

        // ==========================
        // 🔹 Ataques de 2da
        // ==========================
        if (bucket == "2DA")
            return Zonas_2DA.Contains(zona);

        return false;
    }


    // ======================================
    // ✅ CORREGIDO: Cálculo Totales por bucket
    // ======================================
    (int TL, int TD, int AL, int AD, int D2) TotalesPorBucket(
        int rol, TipoLado lado, IEnumerable<AtaqueAccion> acciones)
    {
        int tl = 0, td = 0, al = 0, ad = 0, d2 = 0;

        foreach (var a in acciones ?? Enumerable.Empty<AtaqueAccion>())
        {
            var nombre = a.Accion.ToString();
            var zona = ZonaFromNombre(nombre);
            if (zona == null) continue;
            int t = a.C?.Total ?? 0;

            if (EsPrefijo(nombre, "Tl") && ZonaValida("TL", rol, lado, zona.Value)) { tl += t; continue; }
            if (EsPrefijo(nombre, "Td") && ZonaValida("TD", rol, lado, zona.Value)) { td += t; continue; }
            if (EsPrefijo(nombre, "Atq2da") && ZonaValida("2DA", rol, lado, zona.Value)) { d2 += t; continue; }

            if (EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da"))
            {
                if (ZonaValida("AL", rol, lado, zona.Value)) al += t;
                else if (ZonaValida("AD", rol, lado, zona.Value)) ad += t;
            }
        }
        return (tl, td, al, ad, d2);
    }

    // ======================================
    // ✅ CORREGIDO: BuildAccionesPara
    // ======================================
    List<MapaAccionVM> BuildAccionesPara(
        string bucket, int rol, TipoLado lado, IEnumerable<AtaqueAccion> acciones)
    {
        var list = new List<MapaAccionVM>();
        foreach (var a in acciones ?? Enumerable.Empty<AtaqueAccion>())
        {
            var nombre = a.Accion.ToString();
            var zona = ZonaFromNombre(nombre);
            if (zona == null) continue;

            bool match = bucket switch
            {
                "TL" => EsPrefijo(nombre, "Tl") && ZonaValida("TL", rol, lado, zona.Value),
                "TD" => EsPrefijo(nombre, "Td") && ZonaValida("TD", rol, lado, zona.Value),
                "AL" => EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da") &&
                         ZonaValida("AL", rol, lado, zona.Value),
                "AD" => EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da") &&
                         ZonaValida("AD", rol, lado, zona.Value),
                "2DA" => EsPrefijo(nombre, "Atq2da") && ZonaValida("2DA", rol, lado, zona.Value),
                _ => false
            };
            if (!match) continue;

            var (c, r) = CellOfZona(zona.Value);
            list.Add(new MapaAccionVM(nombre, a.C ?? new AtkCounts(), c, r));
        }
        return list;
    }
}
<!--k1/k2 valores base-->
@{
    var fam = Model.Familias ?? new Dictionary<string, SandStats.Pages.Estadisticas.AtkCounts>();
    SandStats.Pages.Estadisticas.AtkCounts F(string k) =>
        fam.TryGetValue(k, out var v) ? v : new SandStats.Pages.Estadisticas.AtkCounts();

    // ✅ nombres ajustados al formato real de las familias
    var k1Atq = F("AtqLinea");
    var k1Tl = F("ToqueLinea");
    var k1Td = F("ToqueDiago");
    var k12da = F("Atq2da");
    var k1Varios = F("Varios");


    // ✅ CORREGIDO: cálculo total y sin 2da
    var totalK1Principal = k1Atq.Total + k1Tl.Total + k1Td.Total + k1Varios.Total + k12da.Total;
    var totalK1De2da = k12da.Total;
    var totalK1Sin2da = Math.Max(0, totalK1Principal - totalK1De2da);

    // Efectividades
    var dpP_K1Principal = (k1Atq.DP + k1Atq.P) + (k1Tl.DP + k1Tl.P) + (k1Td.DP + k1Td.P) +
                          (k1Varios.DP + k1Varios.P) + (k12da.DP + k12da.P);

    var dpP_sin2da = (k1Atq.DP + k1Atq.P) + (k1Tl.DP + k1Tl.P) +
                     (k1Td.DP + k1Td.P) + (k1Varios.DP + k1Varios.P);

    var efectK1Principal = totalK1Principal == 0 ? 0m : (decimal)dpP_K1Principal / totalK1Principal;
    var efectK1Sin2da = totalK1Sin2da == 0 ? 0m : (decimal)dpP_sin2da / totalK1Sin2da;
    var efectK1De2da = totalK1De2da == 0 ? 0m : (decimal)(k12da.DP + k12da.P) / totalK1De2da;

    // K2
    int totalK2Real = (Model.K2?.PuntosJugados.Total > 0)
        ? Model.K2.PuntosJugados.Total
        : Model.TotalK2;

    decimal efectK2Real = (Model.K2?.PuntosJugados.Total > 0)
        ? Model.K2.PuntosJugados.Efect
        : Model.EfectividadK2;
}

<div class="card bg-light mb-3">
    <div class="card-header fw-semibold">Ataque — Resumen</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle w-100" style="min-width: 760px;">
                <thead class="table-light">
                    <tr>
                        <th style="width:55%;">Métrica</th>
                        <th class="text-end" style="width:15%;">Cant.</th>
                        <th class="text-end" style="width:15%;">Efect.</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>K1 (principal: recepción + 2da)</td>
                        <td class="text-end fw-semibold">@totalK1Principal</td>
                        <td class="text-end fw-semibold @Semaforo(efectK1Principal)">@Pct(efectK1Principal)</td>
                    </tr>
                    <tr>
                        <td>K1 sin pelotas de 2da</td>
                        <td class="text-end fw-semibold">@totalK1Sin2da</td>
                        <td class="text-end fw-semibold @Semaforo(efectK1Sin2da)">@Pct(efectK1Sin2da)</td>
                    </tr>
                    <tr>
                        <td>K1 solo de 2da</td>
                        <td class="text-end fw-semibold">@totalK1De2da</td>
                        <td class="text-end fw-semibold @Semaforo(efectK1De2da)">@Pct(efectK1De2da)</td>
                    </tr>
                    <tr>
                        <td>Total K2</td>
                        <td class="text-end fw-semibold">@totalK2Real</td>
                        <td class="text-end fw-semibold @Semaforo(efectK2Real)">@Pct(efectK2Real)</td>
                    </tr>

                    <tr><td>Cantidad #</td><td class="text-end">@Model.Totales.DP</td><td class="text-end text-muted">@Pct(Model.Totales.PctDP)</td></tr>
                    <tr><td>Cantidad +</td><td class="text-end">@Model.Totales.P</td><td class="text-end text-muted">@Pct(Model.Totales.PctP)</td></tr>
                    <tr><td>Cantidad −</td><td class="text-end">@Model.Totales.N</td><td class="text-end text-muted">@Pct(Model.Totales.PctN)</td></tr>
                    <tr><td>Cantidad =</td><td class="text-end">@Model.Totales.E</td><td class="text-end text-muted">@Pct(Model.Totales.PctE)</td></tr>
                    <tr><td>Varios</td><td class="text-end">@Model.VariosCantidad</td><td class="text-end text-muted">@Pct(Model.VariosEfectividad)</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    bool playerRight = (Model.Rol == 2);
}
@foreach (var lado in new[] { TipoLado.Bueno, TipoLado.Medio, TipoLado.Atras })
{
    var data = Model.Lados?.FirstOrDefault(x => x.Lado == lado)
              ?? new SandStats.Pages.Estadisticas.AtaqueLado { Lado = lado, Totales = new SandStats.Pages.Estadisticas.AtkCounts() };

    var totLado = data.Totales;
    var totalLado = totLado.Total;

    // === Totales de 2da ===
    var total2daLado = (data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>())
        .Where(a => a.Accion.ToString().StartsWith("Atq2da", StringComparison.OrdinalIgnoreCase))
        .Sum(a => a.C.Total);

    var totalLadoK1Sin2da = Math.Max(0, totalLado - total2daLado);
    var pctLadoK1 = totalLadoK1Sin2da == 0 ? 0m : (decimal)totalLadoK1Sin2da / totalLadoK1Sin2da;

    var acciones = data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>();

    // === Totales y mapas basados en el rol del jugador actual ===
    var (totTL, totTD, totAL, totAD, tot2da) = TotalesPorBucket(Model.Rol, data.Lado, acciones);
    var accTL = BuildAccionesPara("TL", Model.Rol, data.Lado, acciones);
    var accTD = BuildAccionesPara("TD", Model.Rol, data.Lado, acciones);
    var accAL = BuildAccionesPara("AL", Model.Rol, data.Lado, acciones);
    var accAD = BuildAccionesPara("AD", Model.Rol, data.Lado, acciones);
    var acc2DA = BuildAccionesPara("2DA", Model.Rol, data.Lado, acciones);

    // === Leyenda para ataques de 2da ===
    var titulo2da = "Ataques de 2da";
    if (Model.Total2da > 0 && !string.IsNullOrWhiteSpace(Model.Dist2daInline))
        titulo2da += " " + Model.Dist2daInline;

    // === ViewModels para parciales ===
    var vmAL = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel
    {
        Titulo = "Atq línea",
        PlayerRight = (Model.Rol == 2),
        TotalAtaques = totalLadoK1Sin2da,
        Acciones = accAL,
        Rol = Model.Rol,
        Lado = data.Lado
    };
    var vmAD = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel
    {
        Titulo = "Atq Diago",
        PlayerRight = (Model.Rol == 2),
        TotalAtaques = totalLadoK1Sin2da,
        Acciones = accAD,
        Rol = Model.Rol,
        Lado = data.Lado
    };
    var vmTD = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel
    {
        Titulo = "Toque Diago",
        PlayerRight = (Model.Rol == 2),
        TotalAtaques = totalLadoK1Sin2da,
        Acciones = accTD,
        Rol = Model.Rol,
        Lado = data.Lado
    };
    var vmTL = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel
    {
        Titulo = "Toques Línea",
        PlayerRight = (Model.Rol == 2),
        TotalAtaques = totalLadoK1Sin2da,
        Acciones = accTL,
        Rol = Model.Rol,
        Lado = data.Lado
    };
    var vm2DA = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel
    {
        Titulo = titulo2da,
        PlayerRight = (Model.Rol == 2),
        TotalAtaques = total2daLado,
        Acciones = acc2DA,
        Rol = Model.Rol,
        Lado = data.Lado,
        TotalFamilia = total2daLado
    };

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="fw-semibold">Lado @data.Lado (Rol @Model.Rol)</div>
            <span class="me-2 text-muted small">
                Varilla: @Pct(totalLado == 0 ? 0 : (decimal)data.TotalVarilla / totalLado)
                (T @data.TotalVarilla)
                Entre línea: @Pct(totalLado == 0 ? 0 : (decimal)data.TotalEntreLinea / totalLado)
                (T @data.TotalEntreLinea)
            </span>
        </div>

        <div class="container-fluid px-0 mb-3">
            <div class="row g-3">
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmAL)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmAD)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmTD)</div>

                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmTL)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vm2DA)</div>

                <!-- ✅ Cuadro violeta - Distribución de acciones -->
                <!-- ✅ Cuadro violeta - Distribución de acciones -->
                <div class="col-md-4">
                    @{
                        // ✅ Totales sin incluir pelotas de 2da
                        int totalSin2da = totAL + totAD + totTD + totTL;

                        // Si no hay acciones, evitamos dividir por cero
                        double P(int v) => totalSin2da > 0 ? 100.0 * v / totalSin2da : 0.0;

                        // ViewModel del resumen
                        var vmPct = new PctResumenVM { TotalAcciones = totalSin2da };

                        // === Carga de ítems ===
                        vmPct.Items.Add(new PctResumenItem { Label = "Ataque Línea (por lado)", Pct = Math.Round(P(totAL), 0) });
                        vmPct.Items.Add(new PctResumenItem { Label = "Ataque Diagonal (por lado)", Pct = Math.Round(P(totAD), 0) });
                        vmPct.Items.Add(new PctResumenItem { Label = "Toque Diagonal (por lado)", Pct = Math.Round(P(totTD), 0) });
                        vmPct.Items.Add(new PctResumenItem { Label = "Toque Línea (por lado)", Pct = Math.Round(P(totTL), 0) });

                        // === Pelotas de 2da (fuera del cálculo de % de lado) ===
                        if (total2daLado > 0)
                        {
                            double pct2da = (totalK1Sin2da + total2daLado) > 0
                            ? 100.0 * total2daLado / (totalK1Sin2da + total2daLado)
                            : 0.0;

                            vmPct.Items.Add(new PctResumenItem
                            {
                                Label = $"2da (Cant: {total2daLado} / total K1({totalK1Sin2da}))",
                                Pct = Math.Round(pct2da, 0)
                            });
                        }
                    }

                    @await Html.PartialAsync(
                    "Estadisticas/Partials/_CuadroResumenPct",
                                vmPct,
                                new ViewDataDictionary(ViewData) { ["Titulo"] = "Distribución de acciones" })
            </div>

        </div>
    </div>

    <!-- ✅ Tabla de acciones normales -->
    <div class="card-body">
        @{
                var filasNormales = acciones.Where(a => !a.Accion.ToString().StartsWith("Atq2da")).ToList();
                var totalLadoSin2da = filasNormales.Sum(x => x.C.Total);

                var filas = filasNormales
                .Select(a => new
                {
                    a.Accion,
                    a.C,
                    PctT = totalLadoSin2da == 0 ? 0m : (decimal)a.C.Total / totalLadoSin2da,
                    TotalVarilla = (data.Lado == SandStats.Models.TipoLado.Medio) ? (int?)null : a.TotalVarilla,
                    TotalEntreLinea = (data.Lado == SandStats.Models.TipoLado.Medio) ? (int?)null : a.TotalEntreLinea
                })
                .OrderByDescending(x => x.PctT)
                .ToList();
            }

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Acción</th>
                            <th>%T <span class="text-muted small">(por lado)</span></th>
                            <th>Efect</th>
                            <th>%#</th>
                            <th>%+</th>
                            <th>%-</th>
                            <th>%=</th>
                            <th>TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in filas)
                        {
                            var c = f.C;
                            <tr class="@Semaforo(c.Efect)">
                                <td class="text-start">@f.Accion</td>
                                <td>@Pct(Math.Round(f.PctT, 2))</td>
                                <td class="text-end fw-semibold @Semaforo(c.Efect)">@Pct(c.Efect)</td>
                                <td>@Pct(c.PctDP)</td>
                                <td>@Pct(c.PctP)</td>
                                <td>@Pct(c.PctN)</td>
                                <td>@Pct(c.PctE)</td>
                                <td>@c.Total</td>
                            </tr>
                        }
                        <tr class="fw-semibold table-secondary">
                            <td class="text-start">Total</td>
                            <td>100%</td>
                            <td class="text-end fw-semibold">@Pct((decimal)filas.Sum(x => x.C.DP + x.C.P) / Math.Max(1, filas.Sum(x => x.C.Total)))</td>
                            <td>@Pct((decimal)filas.Sum(x => x.C.DP) / Math.Max(1, filas.Sum(x => x.C.Total)))</td>
                            <td>@Pct((decimal)filas.Sum(x => x.C.P) / Math.Max(1, filas.Sum(x => x.C.Total)))</td>
                            <td>@Pct((decimal)filas.Sum(x => x.C.N) / Math.Max(1, filas.Sum(x => x.C.Total)))</td>
                            <td>@Pct((decimal)filas.Sum(x => x.C.E) / Math.Max(1, filas.Sum(x => x.C.Total)))</td>
                            <td>@filas.Sum(x => x.C.Total)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- ✅ Tabla 2da -->
            @if (total2daLado > 0)
            {
                var filas2da = acciones.Where(a => a.Accion.ToString().StartsWith("Atq2da")).ToList();
                var total2da = filas2da.Sum(x => x.C.Total);
                var filas2daOrden = filas2da
                .Select(a => new { a.Accion, a.C, PctK1 = total2da == 0 ? 0m : (decimal)a.C.Total / total2da })
                .OrderByDescending(x => x.PctK1)
                .ToList();

                <div class="mt-3">
                    <div class="fw-semibold small mb-1">Acciones especiales — 2da (por este lado)</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start">Acción</th>
                                    <th>%T <span class="text-muted small">(por lado)</span></th>
                                    <th>Efect</th>
                                    <th>%#</th>
                                    <th>%+</th>
                                    <th>%-</th>
                                    <th>%=</th>
                                    <th>TOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in filas2daOrden)
                                {
                                    var c = f.C;
                                    <tr class="@Semaforo(c.Efect)">
                                        <td class="text-start">@f.Accion</td>
                                        <td>@Pct(Math.Round(f.PctK1, 2))</td>
                                        <td class="text-end fw-semibold @Semaforo(c.Efect)">@Pct(c.Efect)</td>
                                        <td>@Pct(c.PctDP)</td>
                                        <td>@Pct(c.PctP)</td>
                                        <td>@Pct(c.PctN)</td>
                                        <td>@Pct(c.PctE)</td>
                                        <td>@c.Total</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
   
}
