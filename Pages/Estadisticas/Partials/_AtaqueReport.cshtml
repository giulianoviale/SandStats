@model SandStats.Pages.Estadisticas.AtaquePlayerReport
@using SandStats.Models
@using System.Linq

@functions {
    string Pct(decimal d) => (d * 100m).ToString("0") + "%";
    string Semaforo(decimal e) =>
        e >= 0.70m ? "bg-success bg-opacity-25"
      : e >= 0.40m ? "bg-warning bg-opacity-25"
      : "bg-danger  bg-opacity-25";

    // “POR x” según lado y rol
    int PorDe(TipoLado lado, int rol)
    {
        if (lado == TipoLado.Medio) return 3;
        if (rol == 4) return lado == TipoLado.Bueno ? 4 : 2;
        return lado == TipoLado.Bueno ? 2 : 4;
    }
}

@functions {
    // ---------- Helpers básicos ----------
    bool EsPrefijo(string nombre, string prefijo)
        => nombre?.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) == true;

    // Extrae zona 1..9 de "Atq1", "Tl9", "Td6" o "Atq2daA1/6/5"
    int? ZonaFromNombre(string nombre)
    {
        nombre ??= "";
        if (nombre.StartsWith("Atq2daA", StringComparison.OrdinalIgnoreCase))
        {
            var suf = nombre.Substring("Atq2daA".Length);
            if (int.TryParse(suf, out var z2)) return z2;
            return null;
        }
        for (int i = nombre.Length - 1; i >= 0; i--)
            if (char.IsDigit(nombre[i]) && int.TryParse(nombre[i].ToString(), out var z)) return z;
        return null;
    }

    // Zonas válidas
    static readonly int[] Zonas_TL_por4 = new[] { 1, 9, 2 };
    static readonly int[] Zonas_TL_por2 = new[] { 5, 7, 4 };

    static readonly int[] Zonas_TD_por4 = new[] { 6, 5, 7, 8, 4, 3 };
    static readonly int[] Zonas_TD_por2 = new[] { 1, 6, 8, 9, 2, 3 };

    static readonly int[] Zonas_AL_por4 = new[] { 1, 9, 2 };
    static readonly int[] Zonas_AL_por2 = new[] { 5, 7, 4 };

    static readonly int[] Zonas_AD_por4 = new[] { 6, 5, 7, 8, 4, 3 };
    static readonly int[] Zonas_AD_por2 = new[] { 6, 1, 9, 8, 2, 3 };

    static readonly int[] Zonas_2DA = new[] { 1, 6, 5 };

    bool ZonaValida(string bucket, int rol, int zona) => bucket switch
    {
        "TL"  => (rol == 4 ? Zonas_TL_por4 : Zonas_TL_por2).Contains(zona),
        "TD"  => (rol == 4 ? Zonas_TD_por4 : Zonas_TD_por2).Contains(zona),
        "AL"  => (rol == 4 ? Zonas_AL_por4 : Zonas_AL_por2).Contains(zona),
        "AD"  => (rol == 4 ? Zonas_AD_por4 : Zonas_AD_por2).Contains(zona),
        "2DA" => Zonas_2DA.Contains(zona),
        _     => false
    };

    // Mapa 3×3 a (col,row): 1 6 5 / 9 8 7 / 2 3 4
    (int col, int row) CellOfZona(int z) => z switch
    {
        1 => (0,0), 6 => (1,0), 5 => (2,0),
        9 => (0,1), 8 => (1,1), 7 => (2,1),
        2 => (0,2), 3 => (1,2), 4 => (2,2),
        _ => (0,0)
    };

    // ---------- Construye lista por bucket (prefijo + zona) ----------
    List<SandStats.Pages.Estadisticas.MapaAccionVM> BuildAccionesPara(
        string bucket, int rol,
        IEnumerable<SandStats.Pages.Estadisticas.AtaqueAccion> accionesDelLado)
    {
        var list = new List<SandStats.Pages.Estadisticas.MapaAccionVM>();
        foreach (var a in accionesDelLado ?? Enumerable.Empty<SandStats.Pages.Estadisticas.AtaqueAccion>())
        {
            var nombre = a.Accion.ToString();
            var zona = ZonaFromNombre(nombre);
            if (zona == null) continue;

            bool match = bucket switch
            {
                "TL"  => EsPrefijo(nombre, "Tl")                      && ZonaValida("TL",  rol, zona.Value),
                "TD"  => EsPrefijo(nombre, "Td")                      && ZonaValida("TD",  rol, zona.Value),
                "2DA" => EsPrefijo(nombre, "Atq2da")                  && ZonaValida("2DA", rol, zona.Value),
                "AL"  => EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da") && ZonaValida("AL",  rol, zona.Value),
                "AD"  => EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da") && ZonaValida("AD",  rol, zona.Value),
                _ => false
            };
            if (!match) continue;

            var (c, r) = CellOfZona(zona.Value);
            list.Add(new SandStats.Pages.Estadisticas.MapaAccionVM(
                nombre, a.C ?? new SandStats.Pages.Estadisticas.AtkCounts(), c, r));
        }
        return list;
    }

    // ---------- Totales por bucket (para % y cuadro) ----------
    (int TL, int TD, int AL, int AD, int D2) TotalesPorBucket(
        int rol, IEnumerable<SandStats.Pages.Estadisticas.AtaqueAccion> accionesDelLado)
    {
        int tl = 0, td = 0, al = 0, ad = 0, d2 = 0;
        foreach (var a in accionesDelLado ?? Enumerable.Empty<SandStats.Pages.Estadisticas.AtaqueAccion>())
        {
            var nombre = a.Accion.ToString();
            var zona = ZonaFromNombre(nombre);
            if (zona == null) continue;
            int t = a.C?.Total ?? 0;

            if (EsPrefijo(nombre, "Atq2da") && ZonaValida("2DA", rol, zona.Value)) { d2 += t; continue; }
            if (EsPrefijo(nombre, "Tl")     && ZonaValida("TL",  rol, zona.Value)) { tl += t; continue; }
            if (EsPrefijo(nombre, "Td")     && ZonaValida("TD",  rol, zona.Value)) { td += t; continue; }

            if (EsPrefijo(nombre, "Atq") && !EsPrefijo(nombre, "Atq2da"))
            {
                if (ZonaValida("AL", rol, zona.Value)) al += t;
                else if (ZonaValida("AD", rol, zona.Value)) ad += t;
            }
        }
        return (tl, td, al, ad, d2);
    }
}

@{
    // familias
    var fam = Model.Familias ?? new Dictionary<string, SandStats.Pages.Estadisticas.AtkCounts>();
    SandStats.Pages.Estadisticas.AtkCounts F(string k) =>
        fam.TryGetValue(k, out var v) ? v : new SandStats.Pages.Estadisticas.AtkCounts();

    var k1Atq = F("Atq");
    var k1Tl = F("Tl");
    var k1Td = F("Td");
    var k12da = F("Atq2da");
    var k1Varios = F("Varios"); // <- Varios cuenta como K1

    // Totales K1
    var totalK1Sin2da = k1Atq.Total + k1Tl.Total + k1Td.Total + k1Varios.Total;
    var totalK1De2da = k12da.Total;
    var totalK1Incl2da = totalK1Sin2da + totalK1De2da;

    var k1DpP = (k1Atq.DP + k1Atq.P) + (k1Tl.DP + k1Tl.P) + (k1Td.DP + k1Td.P) + (k1Varios.DP + k1Varios.P);
    var efectK1 = totalK1Incl2da == 0 ? 0m : (decimal)k1DpP / totalK1Incl2da;

    var efectAtk = Model.Totales.Efect;
    var totalAtaques = Model.Totales.Total;

    decimal pctAtqK1 = totalAtaques == 0 ? 0m : (decimal)totalK1Incl2da / totalAtaques;
    decimal pctNoK1 = 1m - pctAtqK1;

    IEnumerable<TipoLado> ordenLados = new[] { TipoLado.Bueno, TipoLado.Medio, TipoLado.Atras };

    // 🔹 Puntos desde K2
    var totalK2 = Model.K2?.PuntosJugados.Total ?? 0;

    // 🔹 Total (K1 + K2)
    var totalPuntos = totalK1Incl2da + totalK2;
    var denom = totalK1Incl2da + totalK2;
    decimal pctK1SobreTotalCon2da = totalPuntos == 0 ? 0m : (decimal)totalK1Incl2da / totalPuntos;
    decimal pctK1SobreTotal = totalPuntos == 0 ? 0m : (decimal)totalK1Sin2da / totalPuntos;
    decimal pctK2SobreTotal = totalPuntos == 0 ? 0m : (decimal)totalK2 / totalPuntos;
    decimal pct2daSobreTotalK1yK2 = totalPuntos == 0 ? 0m : (decimal)totalK1De2da / denom;
}

@* ======================= ATAQUE — RESUMEN ======================= *@
@{
    string Pct(decimal d) => (d * 100m).ToString("0") + "%";
    Func<decimal, string> Semaforo = v => v >= 0.70m ? "ef-high" : (v >= 0.50m ? "ef-mid" : "ef-low"); // umbrales K1

    var totalK1Principal = totalK1Sin2da + totalK1De2da;
    var efectK1Principal = efectAtk;

    decimal efectK1Sin2da = efectK1Principal; // si luego tenés breakdown propio, cambiás acá
    decimal efectK1De2da = Model.TotalK2;      // placeholder si lo necesitás separado
    decimal efectK2 = Model.TotalK2;
}

<div class="card bg-light mb-3">
    <div class="card-header fw-semibold">Ataque — Resumen</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle w-100" style="min-width: 760px;">
                <thead class="table-light">
                    <tr>
                        <th style="width:55%;">Métrica</th>
                        <th class="text-end" style="width:15%;">Cant.</th>
                        <th class="text-end" style="width:15%;">Efect.</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Cantidad de ataques</td>
                        <td class="text-end fw-semibold">@Model.Totales.Total</td>
                        <td class="text-end text-muted">—</td>
                    </tr>

                    <tr>
                        <td>K1 (principal: recepción + 2da)</td>
                        <td class="text-end fw-semibold">@Model.TotalK1</td>
                        <td class="text-end fw-semibold @Semaforo(Model.EfectividadK1Principal)">
                            @Pct(Model.EfectividadK1Principal)
                        </td>
                    </tr>

                    <tr>
                        <td>K1 sin pelotas de 2da</td>
                        <td class="text-end fw-semibold">@Model.TotalK1Sin2da</td>
                        <td class="text-end fw-semibold @Semaforo(Model.EfectividadK1Sin2da)">
                            @Pct(Model.EfectividadK1Sin2da)
                        </td>
                    </tr>

                    <tr>
                        <td>K1 solo de 2da</td>
                        <td class="text-end fw-semibold">@Model.TotalK1De2da</td>
                        <td class="text-end fw-semibold @Semaforo(Model.EfectividadK1De2da)">
                            @Pct(Model.EfectividadK1De2da)
                        </td>
                    </tr>

                    <tr>
                        <td>Total K2</td>
                        <td class="text-end fw-semibold">@Model.TotalK2</td>
                        <td class="text-end fw-semibold @Semaforo(Model.EfectividadK2)">
                            @Pct(Model.EfectividadK2)
                        </td>
                    </tr>

                    <tr>
                        <td>Cantidad #</td>
                        <td class="text-end">@Model.Totales.DP</td>
                        <td class="text-end text-muted">@Pct(Model.Totales.PctDP)</td>
                    </tr>
                    <tr>
                        <td>Cantidad +</td>
                        <td class="text-end">@Model.Totales.P</td>
                        <td class="text-end text-muted">@Pct(Model.Totales.PctP)</td>
                    </tr>
                    <tr>
                        <td>Cantidad −</td>
                        <td class="text-end">@Model.Totales.N</td>
                        <td class="text-end text-muted">@Pct(Model.Totales.PctN)</td>
                    </tr>
                    <tr>
                        <td>Cantidad =</td>
                        <td class="text-end">@Model.Totales.E</td>
                        <td class="text-end text-muted">@Pct(Model.Totales.PctE)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    // Denominador GLOBAL (K1 + 2da; PorAtras excluido en tu backend)
    var totalGlobal = Model.Totales.Total;
    bool right = (Model.Rol == 2);
}

<!-- ======================= ATAQUE — POR LADO ======================= -->
@{
    var totalGlobalDen = Model.Totales.Total;   // denominador para los mapas
}

@foreach (var lado in ordenLados)
{
    var data = Model.Lados?.FirstOrDefault(x => x.Lado == lado)
               ?? new SandStats.Pages.Estadisticas.AtaqueLado { Lado = lado, Totales = new SandStats.Pages.Estadisticas.AtkCounts() };

    var totLado = data.Totales;
    var totalLado = totLado.Total;

    // total de 2da en este lado
    var total2daLado = (data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>())
        .Where(a => a.Accion.ToString().StartsWith("Atq2da", StringComparison.OrdinalIgnoreCase))
        .Sum(a => a.C.Total);

    // % por lado usando K1 sin 2da
    var totalLadoK1Sin2da = totalLado - total2daLado;
    var pctLadoK1 = totalK1Sin2da == 0 ? 0m : (decimal)totalLadoK1Sin2da / totalK1Sin2da;

    bool Es2da(SandStats.Models.TipoAcciones a)
        => a.ToString().StartsWith("Atq2da", StringComparison.OrdinalIgnoreCase);

    var filasNormales = (data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>())
        .Where(a => !Es2da(a.Accion))
        .ToList();

    var filas2da = (data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>())
        .Where(a => Es2da(a.Accion))
        .ToList();

    var totalLadoSin2da = filasNormales.Sum(x => x.C.Total);

    var filas = filasNormales
        .Select(a => new
        {
            a.Accion,
            a.C,
            PctT = totalLadoSin2da == 0 ? 0m : (decimal)a.C.Total / totalLadoSin2da,
            TotalVarilla = (data.Lado == SandStats.Models.TipoLado.Medio) ? (int?)null : a.TotalVarilla,
            TotalEntreLinea = (data.Lado == SandStats.Models.TipoLado.Medio) ? (int?)null : a.TotalEntreLinea
        })
        .OrderByDescending(x => x.PctT)
        .ThenBy(x => x.Accion.ToString())
        .ToList();

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="fw-semibold">Lado @data.Lado (POR @PorDe(data.Lado, Model.Rol))</div>
            <div class="d-flex align-items-center">
                <span class="me-2 text-muted small">Total (lado)</span>
                <span class="fw-bold text-danger fs-5">@Pct(pctLadoK1)</span>
                <span class="ms-2 text-muted small">(@totalLado)</span>
            </div>
        </div>

        @{
            // ====== Construcción de VMs para los 5 mapas + cuadro % ======
            var accionesDelLado = (data.Acciones ?? new List<SandStats.Pages.Estadisticas.AtaqueAccion>());
            var playerRight = (Model.Rol == 2);

            // Totales por bucket (para la 6ª caja)
            var (totTL, totTD, totAL, totAD, tot2da) = TotalesPorBucket(Model.Rol, accionesDelLado);

            // Acciones para cada bucket
            var accTL  = BuildAccionesPara("TL",  Model.Rol, accionesDelLado);
            var accTD  = BuildAccionesPara("TD",  Model.Rol, accionesDelLado);
            var accAL  = BuildAccionesPara("AL",  Model.Rol, accionesDelLado);
            var accAD  = BuildAccionesPara("AD",  Model.Rol, accionesDelLado);
            var acc2DA = BuildAccionesPara("2DA", Model.Rol, accionesDelLado);

            // ViewModels para cada mapa (con Rol y Lado para posicionar al jugador)
            var vmTL = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel { Titulo = "Toques Línea", PlayerRight = playerRight, TotalAtaques = totalLado, Acciones = accTL, Rol = Model.Rol, Lado = data.Lado };
            var vmTD = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel { Titulo = "Toque diago", PlayerRight = playerRight, TotalAtaques = totalLado, Acciones = accTD, Rol = Model.Rol, Lado = data.Lado };
            var vmAL = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel { Titulo = "Atq línea", PlayerRight = playerRight, TotalAtaques = totalLado, Acciones = accAL, Rol = Model.Rol, Lado = data.Lado };
            var vmAD = new SandStats.Pages.Estadisticas.MapaAtaqueViewModel { Titulo = "Atq Diago", PlayerRight = playerRight, TotalAtaques = totalLado, Acciones = accAD, Rol = Model.Rol, Lado = data.Lado };
            var vm2DA= new SandStats.Pages.Estadisticas.MapaAtaqueViewModel { Titulo = "Ataques de 2da", PlayerRight = playerRight, TotalAtaques = totalLado, Acciones = acc2DA, Rol = Model.Rol, Lado = data.Lado };
            // 6ª caja: % por familia usando los totales
            int total = totAD + totAL + totTD + totTL + tot2da;
            double P(int v) => total > 0 ? 100.0 * v / total : 0.0;

            var vmPct = new PctResumenVM { TotalAcciones = total };
            vmPct.Items.Add(new PctResumenItem { Label = "Ataque Diagonal", Pct = P(totAD) });
            vmPct.Items.Add(new PctResumenItem { Label = "Ataque Línea",    Pct = P(totAL) });
            vmPct.Items.Add(new PctResumenItem { Label = "Toque Diagonal",  Pct = P(totTD) });
            vmPct.Items.Add(new PctResumenItem { Label = "Toque Línea",     Pct = P(totTL) });
            vmPct.Items.Add(new PctResumenItem { Label = "2da",             Pct = P(tot2da) });
        }

        <div class="container-fluid px-0 mb-3">
            <div class="row g-3">
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmAL)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmAD)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmTD)</div>

                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vmTL)</div>
                <div class="col-md-4">@await Html.PartialAsync("Partials/_MapaAccionSVGPartial", vm2DA)</div>

                <div class="col-md-4">
                    @await Html.PartialAsync("Partials/_CuadroResumenPct", vmPct)
                </div>
            </div>
        </div>

        <div class="card-body">
            @if (data.Lado != SandStats.Models.TipoLado.Medio)
            {
                <div class="mb-2 small text-muted">
                    Varilla: @Pct(totalLado == 0 ? 0 : (decimal)data.TotalVarilla / totalLado) (T @data.TotalVarilla)
                    <span class="ms-3">Entre línea: @Pct(totalLado == 0 ? 0 : (decimal)data.TotalEntreLinea / totalLado) (T @data.TotalEntreLinea)</span>
                </div>
            }
            @{
                var totNorm = new SandStats.Pages.Estadisticas.AtkCounts
                {
                    DP = filasNormales.Sum(x => x.C.DP),
                    P = filasNormales.Sum(x => x.C.P),
                    N = filasNormales.Sum(x => x.C.N),
                    E = filasNormales.Sum(x => x.C.E)
                };
                var totalVarillaNorm = filasNormales.Sum(x => x.TotalVarilla);
                var totalEntreLineaNorm = filasNormales.Sum(x => x.TotalEntreLinea);
            }
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Acción</th>
                            <th>%T <span class="text-muted small">(sin 2da)</span></th>
                            <th>Efect</th>
                            <th>%#</th>
                            <th>%+</th>
                            <th>%-</th>
                            <th>%=</th>
                            <th>TOTAL</th>
                            <th>%V</th>
                            <th>%E</th>
                            <th>#</th>
                            <th>+</th>
                            <th>-</th>
                            <th>=</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in filas)
                        {
                            var c = f.C;
                            decimal pctV = 0m, pctE = 0m;
                            if (data.Lado != SandStats.Models.TipoLado.Medio)
                            {
                                var totAccion = c.Total;
                                var varillaAccion = f.TotalVarilla ?? 0;
                                var entreLineaAccion = f.TotalEntreLinea ?? 0;
                                pctV = totAccion == 0 ? 0m : (decimal)varillaAccion / totAccion;
                                pctE = totAccion == 0 ? 0m : (decimal)entreLineaAccion / totAccion;
                            }
                            <tr class="@Semaforo(c.Efect)">
                                <td class="text-start">@f.Accion</td>
                                <td>@Pct(f.PctT)</td>
                                <td class="text-end fw-semibold @Semaforo(c.Efect)">@Pct(c.Efect)</td>
                                <td>@Pct(c.PctDP)</td>
                                <td>@Pct(c.PctP)</td>
                                <td>@Pct(c.PctN)</td>
                                <td>@Pct(c.PctE)</td>
                                <td>@c.Total</td>
                                <td class="text-end">@((data.Lado == SandStats.Models.TipoLado.Medio) ? "—" : Pct(pctV))</td>
                                <td class="text-end">@((data.Lado == SandStats.Models.TipoLado.Medio) ? "—" : Pct(pctE))</td>
                                <td>@c.DP</td>
                                <td>@c.P</td>
                                <td>@c.N</td>
                                <td>@c.E</td>
                            </tr>
                        }
                        <tr class="fw-semibold table-secondary">
                            <td class="text-start">Total</td>
                            <td>100%</td>
                            <td class="text-end fw-semibold @Semaforo(totNorm.Efect)">@Pct(totNorm.Efect)</td>

                            <td>@Pct(totNorm.PctDP)</td>
                            <td>@Pct(totNorm.PctP)</td>
                            <td>@Pct(totNorm.PctN)</td>
                            <td>@Pct(totNorm.PctE)</td>

                            <td>@totNorm.Total</td>

                            <td class="text-end">
                                @(data.Lado == SandStats.Models.TipoLado.Medio
                                    ? "—"
                                    : Pct(totNorm.Total == 0 ? 0m : (decimal)totalVarillaNorm / totNorm.Total))
                            </td>
                            <td class="text-end">
                                @(data.Lado == SandStats.Models.TipoLado.Medio
                                    ? "—"
                                    : Pct(totNorm.Total == 0 ? 0m : (decimal)totalEntreLineaNorm / totNorm.Total))
                            </td>

                            <td>@totNorm.DP</td>
                            <td>@totNorm.P</td>
                            <td>@totNorm.N</td>
                            <td>@totNorm.E</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* ==== 2da por lado ==== *@
            @if (total2daLado > 0)
            {
                var filas2daOrden = filas2da
                    .Select(a => new { a.Accion, a.C, PctK1 = totalK1Incl2da == 0 ? 0m : (decimal)a.C.Total / totalK1Incl2da })
                    .OrderByDescending(x => x.PctK1)
                    .ThenBy(x => x.Accion.ToString())
                    .ToList();

                var totEsp = new SandStats.Pages.Estadisticas.AtkCounts
                {
                    DP = filas2da.Sum(x => x.C.DP),
                    P = filas2da.Sum(x => x.C.P),
                    N = filas2da.Sum(x => x.C.N),
                    E = filas2da.Sum(x => x.C.E)
                };

                <div class="mt-3">
                    <div class="fw-semibold small mb-1">Acciones especiales — 2da (por este lado)</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start">Acción</th>
                                    <th>%T <span class="text-muted small">(sobre K1 total)</span></th>
                                    <th>Efect</th>
                                    <th>%#</th>
                                    <th>%+</th>
                                    <th>%-</th>
                                    <th>%=</th>
                                    <th>TOTAL</th>
                                    <th>#</th>
                                    <th>+</th>
                                    <th>-</th>
                                    <th>=</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in filas2daOrden)
                                {
                                    var c = f.C;
                                    <tr class="@Semaforo(c.Efect)">
                                        <td class="text-start">@f.Accion</td>
                                        <td>@Pct(f.PctK1)</td>
                                        <td class="text-end fw-semibold @Semaforo(c.Efect)">@Pct(c.Efect)</td>
                                        <td>@Pct(c.PctDP)</td>
                                        <td>@Pct(c.PctP)</td>
                                        <td>@Pct(c.PctN)</td>
                                        <td>@Pct(c.PctE)</td>
                                        <td>@c.Total</td>
                                        <td>@c.DP</td>
                                        <td>@c.P</td>
                                        <td>@c.N</td>
                                        <td>@c.E</td>
                                    </tr>
                                }
                                <tr class="fw-semibold table-secondary">
                                    <td class="text-start">Total 2da (lado)</td>
                                    <td>@Pct(totalK1Incl2da == 0 ? 0m : (decimal)total2daLado / totalK1Incl2da)</td>
                                    <td class="text-end fw-semibold @Semaforo(totEsp.Efect)">@Pct(totEsp.Efect)</td>

                                    <td>@Pct(totEsp.PctDP)</td>
                                    <td>@Pct(totEsp.PctP)</td>
                                    <td>@Pct(totEsp.PctN)</td>
                                    <td>@Pct(totEsp.PctE)</td>

                                    <td>@totEsp.Total</td>
                                    <td>@totEsp.DP</td>
                                    <td>@totEsp.P</td>
                                    <td>@totEsp.N</td>
                                    <td>@totEsp.E</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div> <!-- /card-body -->
    </div>     <!-- /card -->
}              <!-- /foreach -->
