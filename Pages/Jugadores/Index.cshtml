@page "{pageIndex:int?}"
@model SandStats.Pages.Jugadores.IndexModel
@{
    ViewData["Title"] = "Listado de Jugadores";
}

<div class="container mt-4">
    <h2 class="mb-4">Listado de Jugadores</h2>

    <a asp-page="Create" class="btn btn-primary mb-3">➕ NUEVO JUGADOR</a>

    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Rol</th>
                <th>Posicion</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jugador in Model.Jugadores)
            {
                <tr>
                    <td>@jugador.Nombre</td>
                    <td>@jugador.Apellido</td>
                    <td>@jugador.RolPrincipal</td>
                    <td>@jugador.Posicion</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@jugador.Id" class="btn btn-sm btn-warning">✏️ EDITAR</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Paginación de jugadores">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-route-pageIndex="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
