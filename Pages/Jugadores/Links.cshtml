@page "{id:int}"
@model SandStats.Pages.Jugadores.LinksModel
@using SandStats.Models

@{
    ViewData["Title"] = "Links de Jugador";
}

<div class="container my-4">
    <h2 class="fw-bold mb-3">Editar Jugador</h2>

    <form method="post" class="card card-body shadow-sm mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="JugadorId" />

        <!-- Datos básicos (solo lectura visual, igual que Edit) -->
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input class="form-control" value="@Model.Jugador.Nombre" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Apellido</label>
            <input class="form-control" value="@Model.Jugador.Apellido" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Rol Principal</label>
            <select class="form-select" disabled
                    asp-items="Model.RolesJugador">
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Posición</label>
            <select class="form-select" disabled
                    asp-items="Model.Posiciones">
            </select>
        </div>

        <hr class="my-4" />

        <h5 class="mb-2">📽️ Links por jugador</h5>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkK1">Link K1</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkK1" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkK2">Link K2</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkK2" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkSaque">Link Saque</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkSaque" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkArmado">Link Armado</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkArmado" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkBloqueo">Link Bloqueo</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkBloqueo" class="form-control" placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label mb-1" asp-for="Links.LinkExtra">Link Extra</label>
                    <div class="input-group">
                        <input type="url" asp-for="Links.LinkExtra" class="form-control" placeholder="https://..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success">
                💾 Guardar cambios
            </button>
            <a asp-page="./Index" class="btn btn-secondary">Volver</a>
        </div>
    </form>
</div>
