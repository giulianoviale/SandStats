@page "{pageIndex:int?}"
@model SandStats.Pages.Partidos.IndexModel
@{
    ViewData["Title"] = "Lista de Partidos";
}

<div class="container mt-4">
    <h2 class="mb-4">Partidos Registrados</h2>

    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Torneo</th>
                <th>Dupla 1</th>
                <th>Dupla 2</th>
                <th>Resultado</th>
                <th>Notas / Video</th>   @* ← Nueva columna *@
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var partido in Model.Partidos)
            {
                <tr>
                    <td>@partido.Fecha.ToShortDateString()</td>
                    <td>@partido.Torneo</td>
                    <td>@partido.Dupla1?.Alias</td>
                    <td>@partido.Dupla2?.Alias</td>
                    <td><strong>@partido.Resultado</strong></td>

                    <!-- ICONOS -->
                    <td>
                        @* Observaciones *@
                        @if (!string.IsNullOrWhiteSpace(partido.Observaciones))
                        {
                            <i class="bi bi-journal-text text-primary me-2"
                               title="Tiene observaciones"></i>
                        }

                        @* Video *@
                        @if (!string.IsNullOrWhiteSpace(partido.VideoUrl))
                        {
                            <a href="@partido.VideoUrl" target="_blank" rel="noopener"
                               title="Ver video del partido">
                                <i class="bi bi-camera-video text-danger"></i>
                            </a>
                        }
                    </td>

                    <td>
                        <a asp-page="/Estadisticas/Resumen" asp-route-partidoId="@partido.Id"
                           class="btn btn-sm btn-primary">
                            Ver Resumen
                        </a>
                        <a asp-page="./Delete" asp-route-id="@partido.Id"
                           class="btn btn-sm btn-outline-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Paginación de partidos">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-route-pageIndex="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
