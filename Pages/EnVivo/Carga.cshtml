@page "{setId:int}"
@model SandStats.Pages.EnVivo.CargaModel
@{
    ViewData["Title"] = $"Carga en vivo — Set {Model.NumeroSet}";
    Layout = "_Layout";
}

@section Styles {
<style>
    .marcador-num { font-size: 4rem; font-weight: 700; line-height: 1; }
    .marcador-sep { font-size: 3rem; font-weight: 300; color: #adb5bd; }
    .panel-marcador { background: #f8f9fa; border-radius: .5rem; padding: 1.5rem; }
    .calidad-dp  { color: #198754; font-weight: 600; }
    .calidad-p   { color: #20c997; }
    .calidad-n   { color: #fd7e14; }
    .calidad-dn  { color: #dc3545; font-weight: 600; }
    .calidad-null { color: #adb5bd; }
    #msg-error   { display: none; }
</style>
}

<div id="envivo-app"
     class="container-fluid py-3"
     data-set-id="@Model.SetId">

    <div class="row g-3 mb-3 align-items-center">
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-sm btn-outline-secondary">← Partidos</a>
        </div>
        <div class="col">
            <h5 class="mb-0">Set @Model.NumeroSet — <span class="text-muted fw-normal">@Model.NombreDupla1 vs @Model.NombreDupla2</span></h5>
        </div>
    </div>

    <div id="msg-error" class="alert alert-danger"></div>

    <div class="row g-4">
        <!-- Panel izquierdo: marcador -->
        <div class="col-md-4">
            <div class="panel-marcador text-center">
                <div class="text-muted small mb-1">Rally <span id="numero-rally">—</span></div>
                <div class="d-flex justify-content-center align-items-center gap-3">
                    <div>
                        <div class="text-muted small">@Model.NombreDupla1</div>
                        <div class="marcador-num" id="marcador-d1">0</div>
                    </div>
                    <div class="marcador-sep">–</div>
                    <div>
                        <div class="text-muted small">@Model.NombreDupla2</div>
                        <div class="marcador-num" id="marcador-d2">0</div>
                    </div>
                </div>
                <div class="mt-2" id="badge-estado"></div>
            </div>

            <div class="mt-3 text-center">
                <button id="btn-abrir-rally"
                        class="btn btn-primary w-100"
                        style="display:none"
                        onclick="abrirRally()">
                    Abrir rally
                </button>
            </div>

            <div class="mt-3 p-3 bg-light rounded" id="panel-sugerencia" style="display:none">
                <div class="fw-semibold mb-1">Próximo paso</div>
                <div id="sugerencia-contenido"></div>
            </div>
        </div>

        <!-- Panel derecho: acciones del rally -->
        <div class="col-md-8">
            <h6 class="fw-semibold mb-2">Acciones del rally</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Fundamento</th>
                            <th>Jugador</th>
                            <th>Calidad</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-acciones">
                        <tr id="fila-vacia">
                            <td colspan="4" class="text-muted text-center">Sin acciones en este rally</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/envivo-carga.js"></script>
}
