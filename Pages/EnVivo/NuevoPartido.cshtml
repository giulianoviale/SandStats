@page
@model SandStats.Pages.EnVivo.NuevoPartidoModel
@{
    ViewData["Title"] = "Nuevo partido en vivo";
}

<div class="container my-4" style="max-width: 600px;">
    <h2 class="fw-bold text-primary mb-3">Nuevo partido en vivo</h2>

    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">Dupla 1</label>
            <select asp-for="Dupla1Id" class="form-select" asp-items="Model.Duplas">
                <option value="">-- Seleccionar dupla --</option>
            </select>
            <span asp-validation-for="Dupla1Id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Dupla 2</label>
            <select asp-for="Dupla2Id" class="form-select" asp-items="Model.Duplas">
                <option value="">-- Seleccionar dupla --</option>
            </select>
            <span asp-validation-for="Dupla2Id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Torneo" class="form-label fw-semibold"></label>
            <input asp-for="Torneo" class="form-control" placeholder="Nombre del torneo" required />
            <span asp-validation-for="Torneo" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Fecha" class="form-label fw-semibold"></label>
            <input asp-for="Fecha" type="date" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Crear partido</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
