@page "{partidoId:int}"
@model SandStats.Pages.EnVivo.IniciarSetModel
@{
    ViewData["Title"] = $"Iniciar set {Model.NumeroSet}";
}

<div class="container my-4" style="max-width: 600px;">
    <h2 class="fw-bold text-primary mb-1">Set @Model.NumeroSet</h2>
    <p class="text-muted mb-4">@Model.Partido.Torneo — @Model.NombreDupla1 vs @Model.NombreDupla2</p>

    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">Sacador inicial — @Model.NombreDupla1</label>
            <select asp-for="SacadorInicialD1Id" class="form-select" asp-items="Model.SacadoresD1">
                <option value="">-- Seleccionar jugador --</option>
            </select>
            <span asp-validation-for="SacadorInicialD1Id" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Sacador inicial — @Model.NombreDupla2</label>
            <select asp-for="SacadorInicialD2Id" class="form-select" asp-items="Model.SacadoresD2">
                <option value="">-- Seleccionar jugador --</option>
            </select>
            <span asp-validation-for="SacadorInicialD2Id" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold d-block">¿Quién saca primero?</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio"
                       asp-for="DuplaQueSacaPrimeroId" id="saca-d1"
                       value="@Model.Partido.Dupla1Id" />
                <label class="form-check-label" for="saca-d1">@Model.NombreDupla1</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio"
                       asp-for="DuplaQueSacaPrimeroId" id="saca-d2"
                       value="@Model.Partido.Dupla2Id" />
                <label class="form-check-label" for="saca-d2">@Model.NombreDupla2</label>
            </div>
            <span asp-validation-for="DuplaQueSacaPrimeroId" class="text-danger d-block"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Iniciar set</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
